    "Init_editing": {
     "type": "InitializeVariable",
     "inputs": {
      "variables": [
       {
        "name": "editing",
        "type": "integer",
        "value": 0
       }
      ]
     },
     "runAfter": {
      "Init_recording": [
       "Succeeded"
      ]
     }
    },
    "Init_learning": {
     "type": "InitializeVariable",
     "inputs": {
      "variables": [
       {
        "name": "learning",
