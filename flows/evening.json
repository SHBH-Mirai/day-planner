     "type": "Compose",
     "inputs": "@convertFromUtc(utcNow(), 'India Standard Time', 'yyyy-MM-dd')"
    },
    "Category_map": {
     "runAfter": {
      "Today": [
       "Succeeded"
      ]
     },
     "type": "Compose",
     "inputs": {
      "office": {
       "icon": "💼",
       "label": "Office",
       "color": "Accent",
       "style": "accent"
      },
      "projects": {
       "icon": "🛠️",
       "label": "Projects",
       "color": "Good",
       "style": "good"
      },
      "youtube": {
       "icon": "🎬",
       "label": "Content",
       "color": "Warning",
       "style": "attention"
      },
      "recording": {
       "icon": "🎙️",
       "label": "Recording",
       "color": "Warning",
       "style": "warning"
      },
      "editing": {
       "icon": "✂️",
       "label": "Editing",
       "color": "Attention",
       "style": "attention"
      },
      "learning": {
       "icon": "📚",
       "label": "Learning",
       "color": "Accent",
       "style": "accent"
      },
      "health": {
       "icon": "💪",
       "label": "Health",
       "color": "Good",
       "style": "good"
      },
      "personal": {
       "icon": "🏠",
       "label": "Personal",
       "color": "Default",
       "style": "emphasis"
      },
      "breaks": {
       "icon": "☕",
       "label": "Breaks & meals",
       "color": "Default",
       "style": "warning"
      }
     }
    },
    "Day_start": {
     "type": "Compose",
     "runAfter": {
      "Category_map": [
       "Succeeded"
      ]
     },
     "inputs": "@convertToUtc(concat(outputs('Today'), 'T00:00:00'), 'India Standard Time')"
    },
