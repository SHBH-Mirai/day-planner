        "value": 0
       }
      ]
     },
     "runAfter": {
      "Init_health": [
       "Succeeded"
      ]
     }
    },
    "Init_breaks": {
     "type": "InitializeVariable",
     "inputs": {
      "variables": [
       {
        "name": "breaks",
        "type": "integer",
        "value": 0
       }
      ]
     },
     "runAfter": {
      "Init_personal": [
       "Succeeded"
      ]
     }
    },
    "Init_done": {
     "type": "InitializeVariable",
     "inputs": {
      "variables": [
       {
        "name": "done",
