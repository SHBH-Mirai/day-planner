     "inputs": {
      "variables": [
       {
        "name": "PausePlanned",
        "type": "integer"
       }
      ]
     }
    },
    "Init_pauseactual": {
     "runAfter": {
      "Init_pauseplanned": [
       "Succeeded"
      ]
     },
     "type": "InitializeVariable",
     "inputs": {
      "variables": [
       {
        "name": "PauseActual",
        "type": "integer"
       }
      ]
     }
    },
    "Get_today": {
     "type": "OpenApiConnection",
     "inputs": {
      "parameters": {
       "dataset": "https://datenshi.sharepoint.com/sites/Development",
       "table": "f0d2c452-c1da-4f3d-8e74-ff03feeb5f77",
       "$orderby": "TaskStart asc",
       "$filter": "TaskStart ge '@{outputs('Day_start')}' and TaskStart lt '@{addDays(outputs('Day_start'), 1)}'"
      },
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "GetItems"
      },
      "authentication": "@parameters('$authentication')"
     },
     "runAfter": {
      "Init_pauseactual": [
       "Succeeded"
      ]
     }
    },
    "Fixed_today": {
     "type": "Query",
     "runAfter": {
      "Get_today": [
       "Succeeded"
      ]
     },
     "inputs": {
      "from": "@body('Get_today')?['value']",
      "where": "@and(equals(item()?['TaskFixed'], true), not(equals(item()?['TaskStatus']?['Value'], 'skipped')))"
     }
    },
    "Each_task": {
     "type": "Foreach",
     "runAfter": {
      "Fixed_today": [
       "Succeeded"
      ]
     },
     "foreach": "@body('Get_today')?['value']",
     "runtimeConfiguration": {
      "concurrency": {
       "repetitions": 1
      }
     },
     "actions": {
      "Reset_pause_planned": {
       "type": "SetVariable",
       "inputs": {
        "name": "PausePlanned",
        "value": 0
       },
       "runAfter": {}
      },
      "Reset_pause_actual": {
       "type": "SetVariable",
       "inputs": {
        "name": "PauseActual",
        "value": 0
       },
       "runAfter": {
        "Reset_pause_planned": [
         "Succeeded"
        ]
       }
      },
      "Each_fixed": {
       "type": "Foreach",
       "runAfter": {
        "Reset_pause_actual": [
         "Succeeded"
        ]
       },
       "runtimeConfiguration": {
        "concurrency": {
         "repetitions": 1
        }
       },
       "foreach": "@if(equals(items('Each_task')?['TaskFixed'], true), json('[]'), body('Fixed_today'))",
       "actions": {
        "Add_pause_planned": {
         "type": "IncrementVariable",
         "runAfter": {},
         "inputs": {
          "name": "PausePlanned",
          "value": "@max(0, div(sub(min(ticks(coalesce(items('Each_task')?['TaskOriginalEnd'], items('Each_task')?['TaskEnd'])), ticks(items('Each_fixed')?['TaskEnd'])), max(ticks(items('Each_task')?['TaskStart']), ticks(items('Each_fixed')?['TaskStart']))), 600000000))"
         }
        },
        "Add_pause_actual": {
         "type": "IncrementVariable",
         "runAfter": {
          "Add_pause_planned": [
           "Succeeded"
          ]
         },
         "inputs": {
          "name": "PauseActual",
          "value": "@max(0, div(sub(min(ticks(coalesce(items('Each_task')?['TaskActualEnd'], items('Each_task')?['TaskStart'])), ticks(items('Each_fixed')?['TaskEnd'])), max(ticks(coalesce(items('Each_task')?['TaskActualStart'], items('Each_task')?['TaskStart'])), ticks(items('Each_fixed')?['TaskStart']))), 600000000))"
         }
        }
       }
      },
      "Planned_min": {
       "type": "Compose",
       "inputs": "@sub(div(add(sub(ticks(coalesce(items('Each_task')?['TaskOriginalEnd'], items('Each_task')?['TaskEnd'])), ticks(items('Each_task')?['TaskStart'])), 300000000), 600000000), variables('PausePlanned'))",
       "runAfter": {
        "Each_fixed": [
         "Succeeded"
        ]
       }
      },
      "Actual_min": {
       "type": "Compose",
       "runAfter": {
        "Planned_min": [
         "Succeeded"
        ]
       },
       "inputs": "@sub(div(add(sub(ticks(coalesce(items('Each_task')?['TaskActualEnd'], items('Each_task')?['TaskStart'])), ticks(coalesce(items('Each_task')?['TaskActualStart'], items('Each_task')?['TaskStart']))), 300000000), 600000000), variables('PauseActual'))"
      },
      "Add_planned": {
       "type": "IncrementVariable",
       "runAfter": {
        "Actual_min": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "planned",
        "value": "@outputs('Planned_min')"
       }
      },
      "Add_actual": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_planned": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "actual",
        "value": "@if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), 0)"
       }
      },
      "Add_office": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_actual": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "office",
        "value": "@if(or(equals(coalesce(items('Each_task')?['TaskCategory']?['Value'], 'office'), 'office'), empty(outputs('Category_map')?[coalesce(items('Each_task')?['TaskCategory']?['Value'], 'office')])), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_projects": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_office": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "projects",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'projects'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_youtube": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_projects": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "youtube",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'youtube'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_recording": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_youtube": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "recording",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'recording'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_editing": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_recording": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "editing",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'editing'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_learning": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_editing": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "learning",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'learning'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_health": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_learning": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "health",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'health'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_personal": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_health": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "personal",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'personal'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_breaks": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_personal": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "breaks",
        "value": "@if(equals(items('Each_task')?['TaskCategory']?['Value'], 'breaks'), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), if(not(empty(items('Each_task')?['TaskActualEnd'])), outputs('Actual_min'), outputs('Planned_min')), if(equals(items('Each_task')?['TaskStatus']?['Value'], 'planned'), outputs('Planned_min'), 0)), 0)"
       }
      },
      "Add_done": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_breaks": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "done",
        "value": "@if(equals(items('Each_task')?['TaskStatus']?['Value'], 'done'), 1, 0)"
       }
      },
      "Add_skipped": {
       "type": "IncrementVariable",
       "runAfter": {
        "Add_done": [
         "Succeeded"
        ]
       },
       "inputs": {
        "name": "skipped",
        "value": "@if(equals(items('Each_task')?['TaskStatus']?['Value'], 'skipped'), 1, 0)"
       }
      }
     }
    },
    "Get_summary_row": {
     "type": "OpenApiConnection",
     "inputs": {
      "parameters": {
       "dataset": "https://datenshi.sharepoint.com/sites/Development",
       "table": "45d16b27-f8e1-48b4-9b1c-8f0070ffeb4b",
       "$filter": "Title eq '@{outputs('Today')}'"
      },
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "GetItems"
      },
      "authentication": "@parameters('$authentication')"
     },
     "runAfter": {
      "Each_task": [
       "Succeeded"
      ]
     }
    },
    "Row_exists": {
     "type": "If",
     "runAfter": {
      "Get_summary_row": [
       "Succeeded"
      ]
     },
     "expression": {
      "and": [
       {
        "greater": [
         "@length(body('Get_summary_row')?['value'])",
         0
        ]
       }
      ]
     },
     "actions": {
      "Update_row": {
       "type": "OpenApiConnection",
       "inputs": {
        "parameters": {
         "dataset": "https://datenshi.sharepoint.com/sites/Development",
         "table": "45d16b27-f8e1-48b4-9b1c-8f0070ffeb4b",
         "id": "@first(body('Get_summary_row')?['value'])?['ID']",
         "item/Title": "@outputs('Today')",
         "item/Day": "@{concat(outputs('Today'), 'T00:00:00Z')}",
         "item/PlannedMin": "@variables('planned')",
         "item/ActualMin": "@variables('actual')",
         "item/Done": "@variables('done')",
         "item/Skipped": "@variables('skipped')",
         "item/OfficeMin": "@variables('office')",
         "item/ProjectsMin": "@variables('projects')",
         "item/YoutubeMin": "@variables('youtube')",
         "item/RecordingMin": "@variables('recording')",
         "item/EditingMin": "@variables('editing')",
         "item/LearningMin": "@variables('learning')",
         "item/HealthMin": "@variables('health')",
         "item/PersonalMin": "@variables('personal')",
         "item/BreaksMin": "@variables('breaks')"
        },
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "PatchItem"
        },
        "authentication": "@parameters('$authentication')"
       }
      }
     },
     "else": {
      "actions": {
       "Create_row": {
        "type": "OpenApiConnection",
        "inputs": {
         "parameters": {
          "dataset": "https://datenshi.sharepoint.com/sites/Development",
          "table": "45d16b27-f8e1-48b4-9b1c-8f0070ffeb4b",
          "item/Title": "@outputs('Today')",
          "item/Day": "@{concat(outputs('Today'), 'T00:00:00Z')}",
          "item/PlannedMin": "@variables('planned')",
          "item/ActualMin": "@variables('actual')",
          "item/Done": "@variables('done')",
          "item/Skipped": "@variables('skipped')",
          "item/OfficeMin": "@variables('office')",
          "item/ProjectsMin": "@variables('projects')",
          "item/YoutubeMin": "@variables('youtube')",
          "item/RecordingMin": "@variables('recording')",
          "item/EditingMin": "@variables('editing')",
          "item/LearningMin": "@variables('learning')",
          "item/HealthMin": "@variables('health')",
          "item/PersonalMin": "@variables('personal')",
          "item/BreaksMin": "@variables('breaks')"
         },
         "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem"
         },
         "authentication": "@parameters('$authentication')"
        }
       }
      }
     }
    },
    "Summary_rows": {
     "type": "Select",
     "runAfter": {
      "Row_exists": [
       "Succeeded"
      ]
     },
     "inputs": {
      "from": "@body('Get_today')?['value']",
      "select": {
       "type": "ColumnSet",
       "separator": true,
       "spacing": "Small",
       "columns": [
        {
         "type": "Column",
         "width": "stretch",
         "items": [
          {
           "type": "TextBlock",
           "text": "@{item()?['Title']}",
           "wrap": true,
           "weight": "Bolder"
          },
          {
           "type": "TextBlock",
           "text": "@{concat('planned ', string(div(add(sub(ticks(coalesce(item()?['TaskOriginalEnd'], item()?['TaskEnd'])), ticks(item()?['TaskStart'])), 300000000), 600000000)), ' · actual ', if(empty(item()?['TaskActualEnd']), '–', string(div(add(sub(ticks(coalesce(item()?['TaskActualEnd'], item()?['TaskStart'])), ticks(coalesce(item()?['TaskActualStart'], item()?['TaskStart']))), 300000000), 600000000))), ' min · ', item()?['TaskStatus']?['Value'])}",
           "wrap": true,
           "isSubtle": true,
           "spacing": "None"
          }
         ]
        },
        {
         "type": "Column",
         "width": "auto",
         "verticalContentAlignment": "Center",
         "items": [
          {
           "type": "TextBlock",
           "text": "@{coalesce(outputs('Category_map')?[coalesce(item()?['TaskCategory']?['Value'], 'office')]?['label'], 'Office')}",
           "wrap": true,
           "weight": "Bolder",
           "color": "@{coalesce(outputs('Category_map')?[coalesce(item()?['TaskCategory']?['Value'], 'office')]?['color'], 'Accent')}"
          }
         ]
        }
       ]
      }
     }
    },
    "Get_tomorrow": {
     "type": "OpenApiConnection",
     "inputs": {
      "parameters": {
       "dataset": "https://datenshi.sharepoint.com/sites/Development",
       "table": "f0d2c452-c1da-4f3d-8e74-ff03feeb5f77",
       "$orderby": "TaskStart asc",
       "$filter": "TaskStart ge '@{addDays(outputs('Day_start'), 1)}' and TaskStart lt '@{addDays(addDays(outputs('Day_start'), 1), 1)}'"
      },
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "GetItems"
      },
      "authentication": "@parameters('$authentication')"
     },
     "runAfter": {
      "Summary_rows": [
       "Succeeded"
      ]
     }
    },
    "Tomorrow_rows": {
     "type": "Select",
     "runAfter": {
      "Get_tomorrow": [
       "Succeeded"
      ]
     },
     "inputs": {
      "from": "@body('Get_tomorrow')?['value']",
      "select": {
       "type": "Container",
       "style": "@{if(and(equals(item()?['TaskStatus']?['Value'], 'planned'), lessOrEquals(ticks(item()?['TaskStart']), ticks(utcNow())), less(ticks(utcNow()), ticks(item()?['TaskEnd']))), 'accent', 'default')}",
       "spacing": "Small",
       "items": [
        {
         "type": "ColumnSet",
         "columns": [
          {
           "type": "Column",
           "width": "auto",
           "items": [
            {
             "type": "TextBlock",
             "text": "@{convertFromUtc(item()?['TaskStart'], 'India Standard Time', 'HH:mm')}",
             "wrap": true,
             "isSubtle": true
            }
           ]
          },
          {
           "type": "Column",
           "width": "auto",
           "items": [
            {
             "type": "TextBlock",
             "text": "@{coalesce(outputs('Category_map')?[coalesce(item()?['TaskCategory']?['Value'], 'office')]?['icon'], '💼')}",
             "wrap": true
            }
           ]
          },
          {
           "type": "Column",
           "width": "stretch",
           "items": [
            {
             "type": "TextBlock",
             "text": "@{concat(if(equals(item()?['TaskStatus']?['Value'], 'done'), '✓ ', ''), if(and(equals(item()?['TaskStatus']?['Value'], 'planned'), lessOrEquals(ticks(item()?['TaskStart']), ticks(utcNow())), less(ticks(utcNow()), ticks(item()?['TaskEnd']))), 'NOW · ', ''), item()?['Title'], if(equals(item()?['TaskStatus']?['Value'], 'skipped'), ' (skipped)', ''))}",
             "wrap": true,
             "weight": "@{if(or(equals(item()?['TaskStatus']?['Value'], 'done'), equals(item()?['TaskStatus']?['Value'], 'skipped')), 'Default', 'Bolder')}",
             "isSubtle": "@or(equals(item()?['TaskStatus']?['Value'], 'done'), equals(item()?['TaskStatus']?['Value'], 'skipped'))"
            }
           ]
          },
          {
           "type": "Column",
           "width": "auto",
           "items": [
            {
             "type": "TextBlock",
             "text": "@{if(and(equals(item()?['TaskStatus']?['Value'], 'planned'), lessOrEquals(ticks(item()?['TaskStart']), ticks(utcNow())), less(ticks(utcNow()), ticks(item()?['TaskEnd']))), concat(string(div(add(sub(ticks(item()?['TaskEnd']), ticks(utcNow())), 300000000), 600000000)), ' min left'), concat(string(div(add(sub(ticks(item()?['TaskEnd']), ticks(item()?['TaskStart'])), 300000000), 600000000)), 'm'))}",
             "wrap": true,
             "isSubtle": true,
             "horizontalAlignment": "Right"
            }
           ]
          }
         ]
        }
       ]
      }
     }
    },
    "Category_minutes": {
     "runAfter": {
      "Tomorrow_rows": [
       "Succeeded"
      ]
     },
     "type": "Compose",
     "inputs": [
      {
       "key": "office",
       "min": "@variables('office')"
      },
      {
       "key": "projects",
       "min": "@variables('projects')"
      },
      {
       "key": "youtube",
       "min": "@variables('youtube')"
      },
      {
       "key": "recording",
       "min": "@variables('recording')"
      },
      {
       "key": "editing",
       "min": "@variables('editing')"
      },
      {
       "key": "learning",
       "min": "@variables('learning')"
      },
      {
       "key": "health",
       "min": "@variables('health')"
      },
      {
       "key": "personal",
       "min": "@variables('personal')"
      },
      {
       "key": "breaks",
       "min": "@variables('breaks')"
      }
     ]
    },
    "Category_with_time": {
     "runAfter": {
      "Category_minutes": [
       "Succeeded"
      ]
     },
     "type": "Query",
     "inputs": {
      "from": "@outputs('Category_minutes')",
      "where": "@greater(item()?['min'], 0)"
     }
    },
    "Bar_columns": {
     "runAfter": {
      "Category_with_time": [
       "Succeeded"
      ]
     },
     "type": "Select",
     "inputs": {
      "from": "@body('Category_with_time')",
      "select": {
       "type": "Column",
       "width": "@max(item()?['min'], 1)",
       "style": "@outputs('Category_map')?[item()?['key']]?['style']",
       "spacing": "Small",
       "minHeight": "8px",
       "items": [
        {
         "type": "TextBlock",
         "text": " ",
         "size": "Small"
        }
       ]
      }
     }
    },
    "Minutes_text": {
     "runAfter": {
      "Bar_columns": [
       "Succeeded"
      ]
     },
     "type": "Select",
     "inputs": {
      "from": "@body('Category_with_time')",
      "select": "@{concat(outputs('Category_map')?[item()?['key']]?['icon'], ' ', outputs('Category_map')?[item()?['key']]?['label'], ' ', if(less(item()?['min'], 60), concat(string(item()?['min']), 'm'), concat(string(div(item()?['min'], 60)), 'h ', string(mod(item()?['min'], 60)), 'm')))}"
     }
    },
    "Card": {
     "type": "Compose",
     "runAfter": {
      "Minutes_text": [
       "Succeeded"
      ]
     },
     "inputs": {
      "type": "AdaptiveCard",
      "version": "1.4",
      "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
      "body": [
       {
        "type": "Container",
        "style": "accent",
        "bleed": true,
        "items": [
         {
          "type": "ColumnSet",
          "columns": [
           {
            "type": "Column",
            "width": "stretch",
            "items": [
             {
              "type": "TextBlock",
              "text": "@{concat('Shutdown · ', convertFromUtc(utcNow(), 'India Standard Time', 'ddd, d MMM'))}",
              "wrap": true,
              "weight": "Bolder"
             }
            ]
           },
           {
            "type": "Column",
            "width": "auto",
            "items": [
             {
              "type": "TextBlock",
              "text": "@{concat(string(variables('done')), ' of ', string(length(body('Get_today')?['value'])), ' done')}",
              "wrap": true,
              "weight": "Bolder",
              "horizontalAlignment": "Right",
              "color": "Good"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "type": "TextBlock",
        "text": "@{concat('Nice work. ', if(less(variables('actual'), 60), concat(string(variables('actual')), 'm'), concat(string(div(variables('actual'), 60)), 'h ', string(mod(variables('actual'), 60)), 'm')), ' focused.')}",
        "wrap": true,
        "size": "Large",
        "weight": "Bolder",
        "spacing": "Medium"
       },
       {
        "type": "ColumnSet",
        "spacing": "Small",
        "columns": "@body('Bar_columns')",
        "isVisible": "@greater(length(body('Category_with_time')), 0)"
       },
       {
        "type": "TextBlock",
        "text": "@{join(body('Minutes_text'), '   ')}",
        "wrap": true,
        "isSubtle": true,
        "size": "Small",
        "spacing": "Small",
        "isVisible": "@greater(length(body('Category_with_time')), 0)"
       },
       {
        "type": "TextBlock",
        "text": "Tomorrow starts with",
        "wrap": true,
        "weight": "Bolder",
        "isSubtle": true,
        "spacing": "Medium",
        "separator": true
       },
       {
        "type": "Container",
        "items": "@if(empty(body('Tomorrow_rows')), json('[{\"type\":\"TextBlock\",\"text\":\"Nothing planned yet.\",\"isSubtle\":true}]'), take(body('Tomorrow_rows'), 1))"
       },
       {
        "type": "Container",
        "id": "details",
        "isVisible": false,
        "items": [
         {
          "type": "TextBlock",
          "text": "Today, task by task",
          "wrap": true,
          "weight": "Bolder",
          "isSubtle": true,
          "spacing": "Medium",
          "separator": true
         },
         {
          "type": "Container",
          "items": "@if(empty(body('Summary_rows')), json('[{\"type\":\"TextBlock\",\"text\":\"No tasks today.\",\"isSubtle\":true,\"wrap\":true}]'), body('Summary_rows'))"
         }
        ]
       }
      ],
      "actions": "@if(greater(variables('skipped'), 0), json(concat('[{\"type\":\"Action.Submit\",\"id\":\"add\",\"title\":\"+ Plan tomorrow\",\"data\":{\"choice\":\"add\"}},{\"type\":\"Action.Submit\",\"id\":\"moveskipped\",\"title\":\"↪ Move ', string(variables('skipped')), ' skipped to tomorrow\",\"data\":{\"choice\":\"moveskipped\"}},{\"type\":\"Action.ToggleVisibility\",\"title\":\"Details\",\"targetElements\":[\"details\"]}]')), json('[{\"type\":\"Action.Submit\",\"id\":\"add\",\"title\":\"+ Plan tomorrow\",\"data\":{\"choice\":\"add\"}},{\"type\":\"Action.ToggleVisibility\",\"title\":\"Details\",\"targetElements\":[\"details\"]}]'))"
     }
    },
    "Post_evening": {
     "runAfter": {
      "Card": [
       "Succeeded"
      ]
     },
     "limit": {
      "timeout": "PT2H"
     },
     "type": "OpenApiConnectionWebhook",
     "inputs": {
      "parameters": {
       "poster": "Flow bot",
       "location": "Chat with Flow bot",
       "body/body/messageBody": "@{string(outputs('Card'))}",
       "body/body/updateMessage": "Got it.",
       "body/body/recipient/to": "ShubhamDubey@Datenshi.onmicrosoft.com"
      },
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
       "connectionName": "shared_teams",
       "operationId": "PostCardAndWaitForResponse"
      },
      "authentication": "@parameters('$authentication')"
     }
    },
    "No_answer": {
     "type": "Compose",
     "runAfter": {
      "Post_evening": [
       "TimedOut"
      ]
     },
     "inputs": "no answer"
    },
    "Choice_evening": {
     "type": "Compose",
     "runAfter": {
      "Post_evening": [
       "Succeeded"
      ]
     },
     "inputs": "@coalesce(body('Post_evening')?['data']?['choice'], body('Post_evening')?['submitActionId'], '')"
    },
    "Is_move": {
     "type": "If",
     "runAfter": {
      "Choice_evening": [
       "Succeeded"
      ]
     },
     "expression": {
      "and": [
       {
        "equals": [
         "@outputs('Choice_evening')",
         "moveskipped"
        ]
       }
      ]
     },
     "actions": {
      "Skipped_today": {
       "type": "Query",
       "inputs": {
        "from": "@body('Get_today')?['value']",
        "where": "@equals(item()?['TaskStatus']?['Value'], 'skipped')"
       }
      },
      "Each_skipped": {
       "type": "Foreach",
       "runAfter": {
        "Skipped_today": [
         "Succeeded"
        ]
       },
       "foreach": "@body('Skipped_today')",
       "runtimeConfiguration": {
        "concurrency": {
         "repetitions": 1
        }
       },
       "actions": {
        "New_start": {
         "type": "Compose",
         "inputs": "@addDays(items('Each_skipped')?['TaskStart'], 1)"
        },
        "Already_there": {
         "type": "Query",
         "runAfter": {
          "New_start": [
           "Succeeded"
          ]
         },
         "inputs": {
          "from": "@body('Get_tomorrow')?['value']",
          "where": "@and(equals(item()?['Title'], items('Each_skipped')?['Title']), equals(ticks(item()?['TaskStart']), ticks(outputs('New_start'))))"
         }
        },
        "Not_there": {
         "type": "If",
         "runAfter": {
          "Already_there": [
           "Succeeded"
          ]
         },
         "expression": {
          "and": [
           {
            "equals": [
             "@length(body('Already_there'))",
             0
            ]
           }
          ]
         },
         "actions": {
          "Create_moved": {
           "type": "OpenApiConnection",
           "inputs": {
            "parameters": {
             "dataset": "https://datenshi.sharepoint.com/sites/Development",
             "table": "f0d2c452-c1da-4f3d-8e74-ff03feeb5f77",
             "item/Title": "@items('Each_skipped')?['Title']",
             "item/TaskStart": "@outputs('New_start')",
             "item/TaskEnd": "@addDays(coalesce(items('Each_skipped')?['TaskOriginalEnd'], items('Each_skipped')?['TaskEnd']), 1)",
             "item/TaskOriginalEnd": "@addDays(coalesce(items('Each_skipped')?['TaskOriginalEnd'], items('Each_skipped')?['TaskEnd']), 1)",
             "item/TaskCategory/Value": "@coalesce(items('Each_skipped')?['TaskCategory']?['Value'], 'office')",
             "item/TaskStatus/Value": "planned",
             "item/TaskDescription": "@coalesce(items('Each_skipped')?['TaskDescription'], '')",
             "item/TaskFixed": "@equals(items('Each_skipped')?['TaskFixed'], true)"
            },
            "host": {
             "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
             "connectionName": "shared_sharepointonline",
             "operationId": "PostItem"
            },
            "authentication": "@parameters('$authentication')"
           }
          },
          "Count_moved": {
           "type": "IncrementVariable",
           "runAfter": {
            "Create_moved": [
             "Succeeded"
            ]
           },
           "inputs": {
            "name": "moved",
            "value": 1
           }
          }
         },
         "else": {
          "actions": {}
         }
        }
       }
      },
      "Moved_card": {
       "type": "Compose",
       "runAfter": {
        "Each_skipped": [
         "Succeeded"
        ]
       },
       "inputs": {
        "type": "AdaptiveCard",
        "version": "1.4",
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "body": [
         {
          "type": "TextBlock",
          "text": "@{concat('↪ Moved ', string(variables('moved')), if(equals(variables('moved'), 1), ' task', ' tasks'), ' to tomorrow')}",
          "wrap": true,
          "weight": "Bolder"
         }
        ],
        "actions": []
       }
      },
      "Post_moved": {
       "type": "OpenApiConnection",
       "runAfter": {
        "Moved_card": [
         "Succeeded"
        ]
       },
       "inputs": {
        "parameters": {
         "poster": "Flow bot",
         "location": "Chat with Flow bot",
         "body/recipient": "ShubhamDubey@Datenshi.onmicrosoft.com",
         "body/messageBody": "@{string(outputs('Moved_card'))}"
        },
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
         "connectionName": "shared_teams",
         "operationId": "PostCardToConversation"
        },
        "authentication": "@parameters('$authentication')"
       }
      }
     },
     "else": {
      "actions": {
       "Add_task": {
        "type": "Workflow",
        "inputs": {
         "host": {
          "workflowReferenceName": "c64a024e-c3c9-f111-b377-7c1e520e2265"
         },
         "body": {
          "text": "@addDays(concat(outputs('Today'), 'T00:00:00Z'), 1, 'yyyy-MM-dd')",
          "text_1": "09:00"
         }
        }
       }
      }
     }
    },
    "Finished": {
     "type": "Compose",
     "runAfter": {
      "Is_move": [
       "Succeeded",
       "Skipped",
       "Failed"
      ]
     },
     "inputs": "done"
    }
   },
   "outputs": {}
  }
 },
 "schemaVersion": "1.0.0.0"
}